/**
 * Revive Fitness Studio data server for a GitHub Pages portal.
 * 1) Open the target Google Sheet, then Extensions > Apps Script.
 * 2) Paste this file and set SPREADSHEET_ID below, or keep blank to use the bound Sheet.
 * 3) Run setupReviveSheets() once, authorize, and add each staff member's unique PIN on Staff.
 * 4) Deploy > New deployment > Web app. Execute as you. Choose the access setting suitable for your studio.
 * 5) Paste the deployment URL ending /exec into Portal > Settings.
 *
 * Staff PINs are app-level identification, not a substitute for Google account security.
 * Keep the Sheet private. Apps Script's web app is a privileged data endpoint.
 */
const SPREADSHEET_ID = '';
const TAB = {members:'Members',transactions:'Transactions',attendance:'Attendance',staff:'Staff',settings:'Settings'};
const HEADERS = {
  Members:['memberId','name','phone','email','gender','admissionDate','plan','fee','expiry','status','lastVisit','signature','notes','createdAt','updatedAt'],
  Transactions:['transactionId','memberId','memberName','amount','type','date','method','staff','createdAt'],
  Attendance:['attendanceId','memberId','memberName','date','time','staff','createdAt'],
  Staff:['staffId','name','pin','role','active'],
  Settings:['key','value']
};
function book_(){return SPREADSHEET_ID?SpreadsheetApp.openById(SPREADSHEET_ID):SpreadsheetApp.getActiveSpreadsheet()}
function setupReviveSheets(){const ss=book_();Object.keys(HEADERS).forEach(name=>{let sh=ss.getSheetByName(name);if(!sh)sh=ss.insertSheet(name);if(sh.getLastRow()===0)sh.appendRow(HEADERS[name]);sh.setFrozenRows(1);sh.getRange(1,1,1,HEADERS[name].length).setFontWeight('bold').setBackground('#ff6500').setFontColor('#ffffff');});const settings=ss.getSheetByName(TAB.settings);if(settings.getLastRow()===1){settings.appendRow(['plans',JSON.stringify([{name:'Monthly',fee:2500,days:30},{name:'Quarterly',fee:6500,days:90},{name:'Half-yearly',fee:12000,days:180},{name:'Annual',fee:22000,days:365}])]);settings.appendRow(['currency','₹']);}return 'Revive Fitness sheets are ready.'}
function json_(value){return ContentService.createTextOutput(JSON.stringify(value)).setMimeType(ContentService.MimeType.JSON)}
function rows_(name){const sh=book_().getSheetByName(name);if(!sh||sh.getLastRow()<2)return[];const values=sh.getRange(2,1,sh.getLastRow()-1,HEADERS[name].length).getValues();return values.filter(r=>r.some(v=>v!==''&&v!==null)).map(r=>{const o={};HEADERS[name].forEach((k,i)=>o[k]=cell_(r[i]));return o})}
function cell_(v){if(v instanceof Date)return Utilities.formatDate(v,Session.getScriptTimeZone(),'yyyy-MM-dd');return v}
function uiMember_(m){return Object.assign({},m,{id:m.memberId})}
function uiPayment_(p){return Object.assign({},p,{id:p.transactionId})}
function uiAttendance_(a){return Object.assign({},a,{id:a.attendanceId})}
function append_(name,obj){const row=HEADERS[name].map(k=>obj[k]===undefined?'':obj[k]);book_().getSheetByName(name).appendRow(row)}
function doGet(e){try{const action=(e.parameter.action||'getData');if(action==='nextAdmissionNumber')return json_({ok:true,nextAdmissionNumber:nextAdmissionNumber_()});if(action==='findMember'){const q=String(e.parameter.query||'').toLowerCase();const members=rows_(TAB.members).filter(m=>m.status==='Active'&&[m.memberId,m.name,m.phone].some(v=>String(v||'').toLowerCase().includes(q)));return json_({ok:true,members:members.map(uiMember_)})}if(action==='getData'){const settings={};rows_(TAB.settings).forEach(r=>settings[r.key]=r.value);let plans=[];try{plans=JSON.parse(settings.plans||'[]')}catch(_){}return json_({ok:true,members:rows_(TAB.members).filter(m=>m.status!=='Deleted').map(uiMember_),payments:rows_(TAB.transactions).map(uiPayment_),attendance:rows_(TAB.attendance).map(uiAttendance_),settings:{plans,currency:settings.currency||'₹'},nextAdmissionNumber:nextAdmissionNumber_()})}return json_({ok:false,error:'Unknown action.'})}catch(err){return json_({ok:false,error:String(err.message||err)})}}
function doPost(e){const lock=LockService.getScriptLock();try{lock.waitLock(20000);const body=JSON.parse(e.postData.contents||'{}');const a=body.action;if(a==='validatePin')return json_(validatePin_(body.pin));if(a==='createAdmission')return json_(createAdmission_(body));if(a==='recordPayment')return json_(recordPayment_(body));if(a==='checkIn')return json_(checkIn_(body));if(a==='archiveMember')return json_(archiveMember_(body));if(a==='updatePlans')return json_(updatePlans_(body));return json_({ok:false,error:'Unknown action.'})}catch(err){return json_({ok:false,error:String(err.message||err)})}finally{try{lock.releaseLock()}catch(_){}}}
function validatePin_(pin){const p=String(pin||'');if(!p)return{ok:false,error:'Enter your staff PIN.'};const s=rows_(TAB.staff).find(x=>String(x.pin)===p&&(x.active===true||String(x.active).toLowerCase()==='true'||x.active==='Yes'));if(!s)return{ok:false,error:'That PIN was not recognized, or the staff account is inactive.'};return{ok:true,staff:{name:s.name,role:s.role||'Staff'}}}
function requireStaff_(pin){const result=validatePin_(pin);if(!result.ok)throw new Error(result.error);return result.staff}
function nextAdmissionNumber_(){const ids=rows_(TAB.members).map(m=>Number(String(m.memberId).match(/(\d+)$/)?.[1]||0));return Math.max(0,...ids)+1}
function createAdmission_(b){const staff=requireStaff_(b.pin);const m=b.member||{},p=b.payment||{};if(!m.name||!m.phone)throw new Error('Member name and phone are required.');const phone=String(m.phone).replace(/\D/g,'');if(phone.length<8)throw new Error('Enter a valid phone number.');const duplicate=rows_(TAB.members).some(x=>String(x.phone).replace(/\D/g,'')===phone&&x.status!=='Deleted');if(duplicate)throw new Error('This phone number already belongs to a member.');const id='RF-'+String(m.admissionDate||new Date().toISOString().slice(0,10)).slice(0,4)+'-'+String(nextAdmissionNumber_()).padStart(4,'0');m.memberId=id;m.phone=phone;m.status='Active';m.createdAt=new Date().toISOString();m.updatedAt=m.createdAt;append_(TAB.members,{memberId:id,name:m.name,phone:m.phone,email:m.email,gender:m.gender,admissionDate:m.admissionDate,plan:m.plan,fee:m.fee,expiry:m.expiry,status:m.status,lastVisit:'',signature:m.signature,notes:m.notes,createdAt:m.createdAt,updatedAt:m.updatedAt});const tx={transactionId:'TX-'+Utilities.getUuid(),memberId:id,memberName:m.name,amount:Number(p.amount||m.fee||0),type:p.type||'Admission',date:p.date||m.admissionDate,method:p.method||'Cash',staff:staff.name,createdAt:new Date().toISOString()};append_(TAB.transactions,tx);return{ok:true,member:m,transaction:tx}}
function recordPayment_(b){const staff=requireStaff_(b.pin);const p=b.payment||{};const m=rows_(TAB.members).find(x=>x.memberId===p.memberId);if(!m)throw new Error('Member not found.');const tx={transactionId:'TX-'+Utilities.getUuid(),memberId:m.memberId,memberName:m.name,amount:Number(p.amount||0),type:p.type||'Membership fee',date:p.date||new Date().toISOString().slice(0,10),method:p.method||'Cash',staff:staff.name,createdAt:new Date().toISOString()};if(tx.amount<=0)throw new Error('Payment amount must be greater than zero.');append_(TAB.transactions,tx);return{ok:true,transaction:tx}}
function checkIn_(b){const staff=requireStaff_(b.pin);const a=b.attendance||{};const m=rows_(TAB.members).find(x=>x.memberId===a.memberId&&x.status==='Active');if(!m)throw new Error('Active member not found.');const day=a.date||new Date().toISOString().slice(0,10);if(rows_(TAB.attendance).some(x=>x.memberId===m.memberId&&x.date===day))throw new Error('This member is already checked in today.');const record={attendanceId:'AT-'+Utilities.getUuid(),memberId:m.memberId,memberName:m.name,date:day,time:a.time||new Date().toLocaleTimeString(),staff:staff.name,createdAt:new Date().toISOString()};append_(TAB.attendance,record);const sh=book_().getSheetByName(TAB.members),row=findRow_(TAB.members,'memberId',m.memberId);if(row)sh.getRange(row,HEADERS.Members.indexOf('lastVisit')+1).setValue(day);return{ok:true,attendance:record}}
function archiveMember_(b){const staff=requireStaff_(b.pin);const row=findRow_(TAB.members,'memberId',b.memberId);if(!row)throw new Error('Member not found.');const sh=book_().getSheetByName(TAB.members);sh.getRange(row,HEADERS.Members.indexOf('status')+1).setValue('Inactive');sh.getRange(row,HEADERS.Members.indexOf('updatedAt')+1).setValue(new Date().toISOString());return{ok:true,archived:true,by:staff.name}}
function updatePlans_(b){requireStaff_(b.pin);const list=b.plans||[];if(!list.length)throw new Error('Add at least one membership plan.');const sh=book_().getSheetByName(TAB.settings),rows=rows_(TAB.settings),row=rows.findIndex(x=>x.key==='plans');const value=JSON.stringify(list);if(row<0)sh.appendRow(['plans',value]);else sh.getRange(row+2,2).setValue(value);return{ok:true,plans:list}}
function findRow_(tab,key,value){const sh=book_().getSheetByName(tab);if(sh.getLastRow()<2)return 0;const col=HEADERS[tab].indexOf(key)+1;const vals=sh.getRange(2,col,sh.getLastRow()-1,1).getValues();const i=vals.findIndex(r=>String(r[0])===String(value));return i<0?0:i+2}
